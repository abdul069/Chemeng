{
  "name": "@gezinsbord/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --disable-warning=ExperimentalWarning dist/index.js",
    "test": "rm -rf ${TMPDIR:-/tmp}/gezinsbord-test && DATA_DIR=${TMPDIR:-/tmp}/gezinsbord-test tsx --test --test-concurrency=1 src/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "node-ical": "^0.27.3",
    "web-push": "^3.6.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
