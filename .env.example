# Sleutel voor de assistent (https://console.anthropic.com). Zonder sleutel werkt alles behalve de assistent.
ANTHROPIC_API_KEY=
# Optioneel: ander Claude-model voor de assistent
# CLAUDE_MODEL=claude-opus-5-5

# Tijdzone voor gekoppelde agenda's
TZ=Europe/Brussels
# Elke hoeveel minuten gekoppelde agenda's bijgewerkt worden
CALENDAR_SYNC_MINUTES=15

# Betalen in de app (Stripe). Leeg = "komt eraan" in de app.
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_GEZIN_MONTH=price_...
# STRIPE_PRICE_GEZIN_YEAR=price_...
# STRIPE_PRICE_PLUS_MONTH=price_...
# STRIPE_PRICE_PLUS_YEAR=price_...
# Publieke URL van de app (voor de terugkeer na betalen)
# PUBLIC_URL=https://kinday.app

# Gedeelde mailbox voor de gezinsinbox (plus-adres per gezin)
# INBOX_IMAP_HOST=imap.example.be
# INBOX_IMAP_USER=inbox@kinday.be
# INBOX_IMAP_PASS=
